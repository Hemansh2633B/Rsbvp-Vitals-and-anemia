# Public asset URLs only; VITE_* values are shipped to browsers. Never place secrets here.
# Defaults in BrowserPulse use the pinned Tasks Vision WASM URL and the official Face Landmarker task artifact.
# Set an approved self-hosted model URL if your deployment must avoid runtime third-party downloads.
VITE_MEDIAPIPE_WASM_URL=https://cdn.jsdelivr.net/npm/@mediapipe/tasks-vision@1.2.3/wasm
VITE_FACE_LANDMARKER_MODEL_URL=https://storage.googleapis.com/mediapipe-models/face_landmarker/face_landmarker/float16/1/face_landmarker.task

# Commit hash of the build (set by release pipelines, e.g. CI). Baked into research
# exports as software.commit. Local builds leave it unset and export 'unknown'.
# VITE_GIT_SHA=
